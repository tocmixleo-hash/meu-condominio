# ── Desenvolvimento local ─────────────────────────────────────────
# Caminho ABSOLUTO evita o bug do Prisma resolver caminhos relativos
# quando há projetos aninhados (recomendado).
DATABASE_URL="file:/caminho/absoluto/para/db/custom.db"

# Segredo de assinatura dos cookies de sessão.
# Gere com: openssl rand -hex 32   (obrigatório em produção!)
SEGREDO_SESSAO="troque-por-um-segredo-longo-e-aleatorio"

# O modo demonstração é detectado automaticamente pelo servidor:
# sem TURSO_DATABASE_URL configurada, o login mostra seletor e acessos rápidos.

# ── Vercel (serverless) ───────────────────────────────────────────
# Modo demonstração (dados resetam a cada cold start):
#   DATABASE_URL="file:/tmp/custom.db"   (sem Turso configurado = modo demo)
# Modo produção real (Turso/libSQL — persistente):
#   TURSO_DATABASE_URL="libsql://seu-banco-seuusuario.turso.io"
#   TURSO_AUTH_TOKEN="token-do-banco-turso"
#   (crie em: app.turso.tech → New database; instruções em DEPLOY.md)
# Na presença de TURSO_DATABASE_URL o runtime usa Turso automaticamente.

# ── Armazenamento de arquivos (recomendado na Vercel) ─────────────
# Documentos, logotipos e fotografias por condomínio. Sem esta chave,
# os arquivos vão para /tmp (perdem no cold start).
# Crie um Blob Store em: Vercel → Storage → Create Database → Blob
# BLOB_READ_WRITE_TOKEN="vercel-blob-token"

# ── Seed de produção (uso único, na estação de operação) ──────────
# Senha provisória do Administrador da Plataforma — alterar no 1º acesso.
# SENHA_ADMIN="escolha-uma-senha-forte"

# ── Notificações por e-mail (opcional) ────────────────────────────
# Sem estas chaves, as notificações ficam apenas no sino do portal.
# RESEND_API_KEY="re_xxx"
# EMAIL_REMETENTE="Meu Condomínio <avisos@seudominio.com.br>"
