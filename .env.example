# ── Desenvolvimento local ─────────────────────────────────────────
# Caminho relativo à pasta prisma/ (aponta para db/custom.db na raiz).
DATABASE_URL="file:../db/custom.db"

# ── Vercel (serverless) ───────────────────────────────────────────
# Configure nas variáveis de ambiente do projeto na Vercel:
#   DATABASE_URL="file:/tmp/custom.db"
# O app copia automaticamente o banco de demonstração (db/custom.db)
# para /tmp no primeiro acesso. Os dados são resetados a cada cold start.
